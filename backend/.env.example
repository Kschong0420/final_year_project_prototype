# Local question and explanation generation. This file is illustrative only; set
# variables in the backend shell before starting Uvicorn.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini
AI_TIMEOUT_SECONDS=45
AI_TEMPERATURE=0.2
AI_NUM_PREDICT=700
AI_MCQ_COUNT=2
AI_BLANK_COUNT=1

# Set these environment variables in the shell before backend startup.
# This example file is not loaded automatically. Restart after changing the values.
CONFUSION_THRESHOLD_PERCENT=50
CONFUSION_MIN_RESPONSES=2

# Lecturer upload limit in whole megabytes; defaults to 25.
MAX_UPLOAD_MB=25

# Optional local LibreOffice rendering for PPTX uploads. The backend also checks PATH
# and standard Windows install locations. Set this if soffice.exe is elsewhere.
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_TIMEOUT_SECONDS=60
